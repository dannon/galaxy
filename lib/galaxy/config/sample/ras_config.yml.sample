# NIH RAS (Researcher Auth Service) GA4GH passport support.
#
# Copy to ras_config.yml in Galaxy's config directory (or point
# ras_config_file at it) to turn the feature on. Passports are kept in Galaxy's
# vault, so vault_config_file must be configured too. Galaxy verifies every
# passport against the issuer's signing keys itself.
#
# Users get a passport through a passport broker, configured with the
# ga4gh_passport_broker_* options in galaxy.yml; when a fetch is refused for
# want of a passport, Galaxy points the user at /ga4gh_passport/connect. With a
# broker configured, ga4gh_passport_trusted_issuers must name the issuer below.

# Passport issuer. RAS staging is https://stsstg.nih.gov, production is
# https://sts.nih.gov.
issuer: https://stsstg.nih.gov

# Signing keys. Found through the issuer's discovery document when not set.
#jwks_uri: https://stsstg.nih.gov/openid/connect/jwks.json

# Seconds of clock skew allowed when checking exp/iat (0-600).
#leeway: 60

# Development only: a way to get a passport when RAS can only redirect to an
# address that is not this Galaxy. Galaxy logs in to RAS as this client and the
# user pastes back the URL RAS sent them to. Setting this turns on the
# /api/users/current/ga4gh_passport/ras_login endpoints (and is read by
# scripts/ras_passport_smoke.py --ras-config). redirect_uri must be one
# registered for the client. The secret is read from the environment variable
# named by client_secret_env.
#direct_ras:
#  client_id: 00000000-0000-0000-0000-000000000000
#  client_secret_env: RAS_CLIENT_SECRET
#  redirect_uri: https://login.example.org/oauth2/callback
#  scopes: openid profile email ga4gh_passport_v1

# URLs Galaxy only fetches for users holding a passport that grants the study.
# The first entry whose url_regex matches (re.match, so anchored at the start)
# decides. Give the study as a literal phs_id, or as a (?P<phs_id>...) group in
# the regex; an entry with neither accepts any valid passport. Keep these in
# step with the DRS file sources that set ga4gh_passport: true in
# file_sources_conf.yml, which decide where the passport is actually sent; the
# two are configured separately and nothing checks that they agree.
#
# The study named here also decides which of the user's grants a dataset
# fetched with the passport is tied to: it stays readable while they hold a
# grant for that study, whatever happens to their other grants. Add the consent
# group (phs000123.c1) to tie it to that one grant. Data from an entry that
# names no study is tied to all of the user's grants, unless its DRS file
# source can ask the repository (gen3_index_url in file_sources_conf.yml).
#protected_sources:
#  - url_regex: '^drs://protected\.example\.org/'
#    phs_id: phs000123
#  - url_regex: '^drs://dbgap\.example\.org/(?P<phs_id>phs\d+)/'
